{
  "netrestrictor": {
    "description": "LibreChat NetRestrictor Security Configuration",
    "version": "1.0",
    "default_policy": {
      "input": "ACCEPT",
      "output": "DROP",
      "forward": "DROP"
    }
  },
  "allowed_connections": {
    "loopback": {
      "enabled": true,
      "description": "Allow loopback traffic for internal processes"
    },
    "established": {
      "enabled": true,
      "description": "Allow established and related connections"
    },
    "dns": {
      "enabled": true,
      "ports": [53],
      "protocols": ["udp"],
      "description": "Allow DNS resolution (Docker internal DNS)"
    },
    "internal_services": {
      "enabled": true,
      "description": "Allow connections to internal LibreChat services",
      "services": [
        {
          "name": "MongoDB",
          "port": 27017,
          "protocol": "tcp"
        },
        {
          "name": "Meilisearch",
          "port": 7700,
          "protocol": "tcp"
        },
        {
          "name": "RAG API",
          "port": 8000,
          "protocol": "tcp"
        },
        {
          "name": "PostgreSQL/VectorDB",
          "port": 5432,
          "protocol": "tcp"
        }
      ]
    },
    "host_services": {
      "enabled": true,
      "description": "Allow connections to host services",
      "target": "host.docker.internal",
      "services": [
        {
          "name": "LibreChat Frontend",
          "port": 3080,
          "protocol": "tcp"
        },
        {
          "name": "OpenAI Chat Proxy",
          "port": 8081,
          "protocol": "tcp"
        }
      ]
    },
    "external_apis": {
      "enabled": true,
      "description": "Allow specific external APIs and OAuth providers",
      "services": [
        {
          "name": "OpenAI API",
          "host": "api.openai.com",
          "port": 443
        },
        {
          "name": "Anthropic API",
          "host": "api.anthropic.com",
          "port": 443
        },
        {
          "name": "Google OAuth",
          "host": "accounts.google.com",
          "port": 443
        },
        {
          "name": "Google APIs",
          "host": "www.googleapis.com",
          "port": 443
        },
        {
          "name": "GitHub OAuth",
          "host": "github.com",
          "port": 443
        },
        {
          "name": "GitHub API",
          "host": "api.github.com",
          "port": 443
        },
        {
          "name": "Discord OAuth",
          "host": "discord.com",
          "port": 443
        },
        {
          "name": "Test Service (should work)",
          "host": "host.docker.internal",
          "port": 8081
        }
      ]
    },
    "external_dns": {
      "enabled": true,
      "description": "Allow external DNS resolution for hostname lookups",
      "servers": [
        {
          "name": "Google Primary DNS",
          "ip": "8.8.8.8",
          "port": 53,
          "protocol": "udp"
        },
        {
          "name": "Google Secondary DNS",
          "ip": "8.8.4.4",
          "port": 53,
          "protocol": "udp"
        },
        {
          "name": "Cloudflare Primary DNS",
          "ip": "1.1.1.1",
          "port": 53,
          "protocol": "udp"
        },
        {
          "name": "Cloudflare Secondary DNS",
          "ip": "1.0.0.1",
          "port": 53,
          "protocol": "udp"
        }
      ],
      "primary_server": "8.8.8.8"
    }
  },
  "logging": {
    "enabled": true,
    "level": "INFO",
    "log_blocked": true,
    "log_allowed": false
  },
  "rules": {
    "allow_loopback": true,
    "drop_invalid": true,
    "log_dropped": true
  }
}